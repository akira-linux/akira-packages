# Template file for 'faugus-launcher'
pkgname=faugus-launcher
version=2.5.1
revision=1
archs="x86_64"
wrksrc="faugus-launcher-${version}"

hostmakedepends="meson ninja pkg-config gettext"
makedepends="gtk4-devel libadwaita-devel libmanette-devel python3-gobject-devel"
depends="gtk4 libadwaita libmanette
 python3-gobject python3-requests python3-Pillow
 python3-vdf python3-psutil python3-icoextract
 xdg-desktop-portal xdg-desktop-portal-gtk"

short_desc="Simple and lightweight app for running Windows games using UMU-Launcher"
maintainer="Akira Linux <dev@akiralinux.org>"
license="GPL-3.0-or-later"
homepage="https://github.com/Faugus/faugus-launcher"
distfiles="https://github.com/Faugus/faugus-launcher/archive/refs/tags/${version}.tar.gz"
checksum=0d0ae82febf6b3924b975f79f277887edc9364de67be89831514400cd94b6db6

do_build() {
    meson setup builddir --prefix=/usr --buildtype=release
    ninja -C builddir
}

do_install() {
    DESTDIR="${DESTDIR}" ninja -C builddir install
}