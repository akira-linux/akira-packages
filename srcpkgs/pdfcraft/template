# Template file for 'pdfcraft'
pkgname=pdfcraft
version=0.9.0
revision=1
archs="x86_64"
wrksrc="pdfcraft-${version}"
hostmakedepends="cargo rust pkg-config"
makedepends="libxkbcommon-devel fontconfig-devel freetype-devel
 wayland-devel wayland-protocols"
depends="glibc libgcc hicolor-icon-theme
 libxkbcommon fontconfig freetype
 wayland
 gnome-keyring xdg-desktop-portal xdg-desktop-portal-gtk"

short_desc="Open-source PDF workbench (clean-room Acrobat reimplementation)"
maintainer="Akira Linux <dev@akiralinux.org>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps/pdfcraft"
distfiles="https://github.com/storytold/pdfcraft/archive/refs/tags/v${version}.tar.gz"
checksum=38476e8448e0941d8e243ee7413ad410bde54085140a24733d211ff1b6117b2e

do_build() {
    cargo build --release --locked
}

do_install() {
	for bin in pdfcraft pdfcraft-cli; do
		if [ -f "target/release/$bin" ]; then
			vbin "target/release/$bin"
		fi
	done

	if [ -d "assets/app-icon/hicolor" ]; then
		vmkdir usr/share/icons
		vcopy assets/app-icon/hicolor usr/share/icons/
	fi

	vmkdir usr/share/applications
	vinstall "${FILESDIR}/pdfcraft.desktop" 644 usr/share/applications
}