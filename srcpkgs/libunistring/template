# Template file for 'libunistring'
pkgname=libunistring
version=1.4.2
revision=1
build_style=gnu-configure
short_desc="Library for manipulating Unicode strings and C strings"
maintainer="Akira Linux <dev@akiralinux.org>"
license="LGPL-3.0-or-later"
homepage="https://www.gnu.org/software/libunistring"
distfiles="${GNU_SITE}/${pkgname}/${pkgname}-${version}.tar.xz"
checksum=5b46e74377ed7409c5b75e7a96f95377b095623b689d8522620927964a41499c

libunistring-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/share
	}
}