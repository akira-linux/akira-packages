# Template file for 'chatgpt-desktop'
pkgname=chatgpt-desktop
version=26.1007.21434
revision=1
archs="x86_64"
wrksrc="chatgpt-${version}"
hostmakedepends="libarchive"
short_desc="ChatGPT desktop application for Linux"
maintainer="cybarchitect <cybarchitect@gmail.com>"
license="custom:OpenAI-Proprietary"
homepage="https://chatgpt.com/download"
distfiles="https://persistent.oaistatic.com/codex-app-prod/linux/deb/latest/chatgpt_amd64.deb>chatgpt_${version}_amd64.deb"
checksum=276b5341c3d74b261d3ad52106f7fa7edde06841e4767fe2a40cb54099b1f3ed
nostrip=yes
noshlibs=yes
noverifyrdeps=yes

depends="alsa-lib at-spi2-core cairo dbus expat gdk-pixbuf glib glibc gtk+3
 libcups libdrm libgbm libgcc libglvnd libnotify libpulseaudio libsecret
 libstdc++ libusb libX11 libxcb libXcomposite libXdamage libXext libXfixes
 libXi libXrandr libXrender libXScrnSaver libXtst libxkbcommon libxshmfence
 mesa nspr nss pango elogind"

do_extract() {
    mkdir -p "${wrksrc}"
    bsdtar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/chatgpt_${version}_amd64.deb" \
        -C "${wrksrc}" --include='data.tar*'
    bsdtar -xf "${wrksrc}"/data.tar.* -C "${wrksrc}"
    rm -f "${wrksrc}"/data.tar.*
}

do_install() {
    vmkdir usr/lib/chatgpt
    vcopy usr/lib/chatgpt/* usr/lib/chatgpt/

    vmkdir usr/bin
    ln -sf ../lib/chatgpt/codex-launcher "${DESTDIR}/usr/bin/chatgpt"

    if [ -f usr/share/applications/chatgpt.desktop ]; then
        vmkdir usr/share/applications
        vinstall usr/share/applications/chatgpt.desktop 644 usr/share/applications
    fi

    if [ -d usr/share/icons ]; then
        vmkdir usr/share/icons
        vcopy usr/share/icons/* usr/share/icons/
    fi

    for d in usr/share/mime usr/share/metainfo; do
        if [ -d "$d" ]; then
            vmkdir "$d"
            vcopy "$d"/* "$d/"
        fi
    done

    if [ -f usr/share/doc/chatgpt/copyright ]; then
        vlicense usr/share/doc/chatgpt/copyright
    else
        vinstall "${FILESDIR}/LICENSE" 644 usr/share/licenses/${pkgname}
    fi
}