# Template file for 'akira-repo'
pkgname=akira-repo
version=1.1
revision=1
archs="x86_64"
short_desc="Akira Linux official repository setup"
maintainer="Akira Linux team <https://akiralinux.org>"
license="Public Domain"
homepage="https://akiralinux.org"

do_install() {
    vinstall "${FILESDIR}/akira-repo.conf" 644 etc/xbps.d
    vinstall "${FILESDIR}/akira.pub" 644 usr/share/akira-repo
}

post_install() {
    mkdir -p /var/db/xbps/keys
    cp /usr/share/akira-repo/akira.pub /var/db/xbps/keys/ 2>/dev/null || true
}