# Template file for 'libffi'
pkgname=libffi
version=3.8.0
revision=1
build_style=gnu-configure
configure_args="--includedir=/usr/include --disable-multi-os-directory --with-pic"
checkdepends="dejagnu"
short_desc="Library supporting Foreign Function Interfaces"
maintainer="Akira Linux <dev@akiralinux.org>"
license="MIT"
homepage="https://sourceware.org/libffi"
changelog="https://github.com/libffi/libffi/raw/master/ChangeLog"
distfiles="https://github.com/libffi/libffi/releases/download/v${version}/libffi-${version}.tar.gz"
checksum=7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4

post_install() {
	vlicense LICENSE
}

libffi-devel_package() {
	depends="libffi>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/share
	}
}